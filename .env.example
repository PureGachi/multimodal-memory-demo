# Copy to .env in the project root; run commands from that directory.
# .env is auto-read; existing process environment variables take priority.
# Never put real secrets in this example file.
MEMORY_PROFILE=local
MEMORY_DATA_DIR=data
MEMORY_EMBEDDINGS=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
# Optional. Empty means local unauthenticated demo.
MEMORY_API_KEY=
# Use MEMORY_EMBEDDINGS=none for an offline lexical-only baseline.

# Image understanding is OFF by default. Enabling compatible sends images to
# your chosen service and may incur fees. Values below are deliberately blank.
MEMORY_VISION=none
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
# json_schema enforces fields on supporting providers; json_object is explicit compatibility mode.
VISION_RESPONSE_FORMAT=json_schema
# Bump this when a mutable provider model changes and you want fresh analyses.
VISION_REVISION=1
# Optional independent CPU OCR (install Tesseract + language packs first).
MEMORY_OCR=none
TESSERACT_EXECUTABLE=tesseract
# Optional language data override. Project Conda paths are auto-detected for an absolute exe path.
# TESSDATA_PREFIX=D:/path/to/project/.conda/share/tessdata
OCR_LANGUAGES=eng
OCR_REVISION=1

# Paid embedding alternative: MEMORY_EMBEDDINGS=compatible
# Supply your Model Studio region/workspace API base URL ending in /compatible-mode/v1.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_REVISION=1
# See .env.competition.example and scripts/enable_competition.ps1 for competition setup.

# API admission limits; oversized inputs are rejected, never silently truncated.
MEMORY_MAX_REQUEST_BYTES=67108864
MEMORY_MAX_INFLIGHT=2
MEMORY_BODY_TIMEOUT_SECONDS=30
