# Copy to .env to auto-read from the working directory; process env takes priority.
# This example filename is NOT auto-loaded. Never put real secrets in this tracked file.
MEMORY_PROFILE=competition
MEMORY_DATA_DIR=data/official/evaluation/runtime
MEMORY_API_KEY=
MEMORY_EMBEDDINGS=compatible
# Copy the actual base URL from your Model Studio workspace (key must match region).
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_REVISION=1
MEMORY_VISION=compatible
VISION_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=
VISION_MODEL=gpt-4o-mini
VISION_RESPONSE_FORMAT=json_schema
VISION_REVISION=1
# Conservative choice while organizer has not clarified local OCR rules.
MEMORY_OCR=none
# Declared deployment capacities, not official universal limits.
MEMORY_MAX_REQUEST_BYTES=67108864
MEMORY_MAX_INFLIGHT=2
MEMORY_BODY_TIMEOUT_SECONDS=30
